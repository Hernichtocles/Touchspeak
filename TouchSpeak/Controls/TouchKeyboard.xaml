<UserControl x:Class="TouchSpeak.Controls.TouchKeyboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <UserControl.Resources>
        <!-- Taste: blau mit weißer Schrift, deutlicher Abstand zu den Nachbarn.
             Keine feste Mindesthöhe – die Reihen teilen sich die verfügbare Höhe, und die
             Viewbox verkleinert die Beschriftung nur dann, wenn die Taste dafür zu klein
             ist (kleine Tablet-Bildschirme), statt dass Tasten unten abgeschnitten werden. -->
        <Style x:Key="KeyButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="7"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KeyForeground}"/>
            <Setter Property="Background" Value="{StaticResource KeyBlue}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="6,4">
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource KeyBlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource KeyBluePressed}"/>
                            </Trigger>
                            <!-- Aktive Umschalt-Taste -->
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource TileActive}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource KeyboardPanel}" CornerRadius="14" Padding="6">
        <!-- UniformGrid statt StackPanel: die Reihen teilen sich die volle Höhe des
             Steuerelements gleichmäßig, damit die Tasten mit dem Fenster mitwachsen. -->
        <UniformGrid x:Name="RowsHost" Columns="1"/>
    </Border>
</UserControl>
