<Window x:Class="TouchSpeak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:TouchSpeak.Controls"
        Title="TouchSpeak &#x2013; Kommunikationshilfe"
        Height="900" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource TextForeground}">

    <Window.Resources>
        <!-- Werkzeug-Taste. Die Viewbox verkleinert nur die Beschriftung, falls die Taste
             auf schmalen Bildschirmen (Tablet, 1280 px logisch) zu eng wird – der Text wird
             nie abgeschnitten, die Leiste bricht nie in eine zweite Zeile um. -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="Background" Value="{StaticResource KeySpecialBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBackground}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigNavButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="MinHeight" Value="72"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource TileBlue}"/>
        </Style>

        <!-- Kompakte Leiste der Schreiben-Seite: bewusst flach, damit die Tastatur darunter
             so viel Höhe wie möglich bekommt (große Ziele für die Kopfsteuerung). -->
        <Style x:Key="SmallToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>
        <Style x:Key="SmallNavButton" TargetType="Button" BasedOn="{StaticResource BigNavButton}">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <!-- Wortvorschlag über der Tastatur: helles Blau, dunkelblaue Schrift. -->
        <Style x:Key="SuggestionButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource SuggestionForeground}"/>
            <Setter Property="Background" Value="{StaticResource SuggestionBackground}"/>
        </Style>

        <!-- Pause (Bediensperre): eine Taste für alle Seiten, oben rechts. Solange die
             Sperre aktiv ist, leuchtet sie rot (pulsierender Schein). -->
        <Style x:Key="PauseButton" TargetType="Button">
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextForeground}"/>
            <Setter Property="Background" Value="{StaticResource KeySpecialBackground}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" Color="#FFFF3B30" BlurRadius="34"
                                                  ShadowDepth="0" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource LockRed}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="glowPulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetName="glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.45" To="1" Duration="0:0:0.7"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="glowPulse"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kopflose Tabs: der Wechsel läuft ausschließlich über die großen Buttons.
             Wichtig: Das Standard-Template des TabControls bleibt erhalten (ein eigenes
             Template ohne TabPanel verhindert, dass die TabItems je erzeugt werden – das
             Fenster bliebe komplett weiß). Es werden nur die Reiter-Köpfe ausgeblendet. -->
        <Style x:Key="HeaderlessTabControl" TargetType="TabControl">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Befehlskachel (Symbol + Beschriftung) für die Vorlesen-Seite. Keine große
             Mindesthöhe: die Kachelreihen teilen sich die Seitenhöhe, und die Viewbox
             verkleinert Symbol + Text nur, wenn die Kachel dafür zu klein ist. -->
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource TileBlue}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="12" Padding="8,6">
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource TileActive}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TileRed" TargetType="Button" BasedOn="{StaticResource Tile}">
            <Setter Property="Background" Value="{StaticResource TileRed}"/>
        </Style>

        <!-- Symbol- und Textzeilen innerhalb einer Kachel. -->
        <Style x:Key="TileGlyph" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
    <TabControl x:Name="Tabs" Background="{StaticResource AppBackground}"
                BorderThickness="0" Margin="8"
                Style="{StaticResource HeaderlessTabControl}"
                SelectionChanged="Tabs_SelectionChanged">

        <!-- ===================== WRITING TAB ===================== -->
        <TabItem x:Name="WritingTab" Header="  Schreiben  " FontSize="18">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Text bekommt ~30 % der Höhe (er scrollt), die Tastatur ~70 %:
                         die Kopfsteuerung braucht große Tasten, aber ein paar Zeilen Text
                         sollen lesbar bleiben. -->
                    <RowDefinition Height="3*" MinHeight="110"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="7*"/>
                </Grid.RowDefinitions>

                <!-- Werkzeugleiste: immer EINE flache Zeile mit gleich breiten Tasten (kein Umbruch,
                     der auf dem Tablet die Tastatur nach unten aus dem Bild schieben würde).
                     Rechts bleibt Platz für die fensterweite Pause-Taste. -->
                <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,150,4">
                    <Button Style="{StaticResource SmallToolButton}" Click="New_Click" Content="&#x1F5D1;  Alles löschen"/>
                    <Button Style="{StaticResource SmallToolButton}" Click="Open_Click" Content="&#x1F4C2;  Öffnen"/>
                    <Button Style="{StaticResource SmallToolButton}" Click="Save_Click" Content="&#x1F4BE;  Exportieren"/>
                    <Button Style="{StaticResource SmallToolButton}" Click="Settings_Click" Content="&#x2699;  Einstellungen"/>
                    <Button Style="{StaticResource SmallToolButton}" Click="SpeakAll_Click" Content="&#x1F509;  Alles vorlesen"/>
                    <Button Style="{StaticResource SmallNavButton}" Click="Speak_Click" Content="&#x1F50A;  Zum Vorlesen"/>
                    <Button Style="{StaticResource SmallToolButton}" Click="Quit_Click" Content="&#x23FB;  Beenden"/>
                </UniformGrid>

                <Border Grid.Row="1" x:Name="WritingEditorHost" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="4">
                    <RichTextBox x:Name="Editor" FontSize="36" Background="Transparent"
                                 Foreground="{StaticResource TextForeground}"
                                 BorderThickness="0" Padding="10"
                                 SpellCheck.IsEnabled="False"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsTab="True"
                                 InputMethod.IsInputMethodEnabled="False"/>
                </Border>

                <UniformGrid Grid.Row="2" x:Name="SuggestionRow" Rows="1" Columns="5" Margin="0,6">
                    <Button x:Name="Sug0" Style="{StaticResource SuggestionButton}" Click="Suggestion_Click" Visibility="Hidden"/>
                    <Button x:Name="Sug1" Style="{StaticResource SuggestionButton}" Click="Suggestion_Click" Visibility="Hidden"/>
                    <Button x:Name="Sug2" Style="{StaticResource SuggestionButton}" Click="Suggestion_Click" Visibility="Hidden"/>
                    <Button x:Name="Sug3" Style="{StaticResource SuggestionButton}" Click="Suggestion_Click" Visibility="Hidden"/>
                    <Button x:Name="Sug4" Style="{StaticResource SuggestionButton}" Click="Suggestion_Click" Visibility="Hidden"/>
                </UniformGrid>

                <ctrl:TouchKeyboard Grid.Row="3" x:Name="Keyboard"/>
            </Grid>
        </TabItem>

        <!-- ===================== READING TAB ===================== -->
        <TabItem x:Name="ReadingTab" Header="  Vorlesen  " FontSize="18">
            <Grid Margin="6">
                <!-- Anteilige Zeilen statt fester Kachelhöhen: Text 2 Anteile, die vier blauen
                     Reihen 4, die zwei roten 2 – so passt die Seite auf jede Bildschirmhöhe. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="110"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,150,6">
                    <Button Style="{StaticResource BigNavButton}" Click="Write_Click" Content="&#x270F;  Zum Schreiben"/>
                    <Button Style="{StaticResource ToolButton}" MinHeight="72" Click="Settings_Click" Content="&#x2699;  Einstellungen"/>
                </WrapPanel>

                <!-- Textbereich; der Editor wird hierher verschoben, sobald der Reiter aktiv ist. -->
                <Border Grid.Row="1" x:Name="ReadingEditorHost"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="10" Padding="4" Margin="0,0,0,8"/>

                <!-- Bearbeiten & Navigieren (blau) -->
                <UniformGrid Grid.Row="2" Columns="4">
                        <Button Style="{StaticResource Tile}" Click="Copy_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F4CB;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Kopieren"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="Paste_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F4CC;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Einfügen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="Undo_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x21B6;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Löschen Rückgängig"/></StackPanel>
                        </Button>
                        <Button x:Name="SelectModeButton" Style="{StaticResource Tile}" Click="ToggleSelect_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x2750;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Text Auswählen"/></StackPanel>
                        </Button>

                        <Button Style="{StaticResource Tile}" Click="Left_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x2190;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Links"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="Right_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x2192;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Rechts"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="Up_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x2191;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Rauf"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="Down_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x2193;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Runter"/></StackPanel>
                        </Button>

                        <Button Style="{StaticResource Tile}" Click="PrevWord_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x23EA;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Vorheriges Wort"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="NextWord_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x23E9;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Nächstes Wort"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="DocStart_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x21E4;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Textanfang"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="DocEnd_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x21E5;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Textende"/></StackPanel>
                        </Button>

                        <Button Style="{StaticResource Tile}" Click="PrevSentence_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x23EE;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Vorheriger Satz"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="NextSentence_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x23ED;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Nächster Satz"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="LineStart_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x21A4;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Zeilenanfang"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource Tile}" Click="LineEnd_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x21A6;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Zeilenende"/></StackPanel>
                        </Button>
                </UniformGrid>

                <!-- Sprechen (rot) -->
                <UniformGrid Grid.Row="3" Columns="3" Margin="0,4,0,0">
                        <Button Style="{StaticResource TileRed}" Click="SpeakParagraph_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F5E3;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Absatz Sprechen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileRed}" Click="SpeakSentence_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F4AC;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Satz Sprechen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileRed}" Click="SpeakWord_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F524;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Wort Sprechen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileRed}" Click="SpeakAll_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F50A;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Alles Sprechen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileRed}" Click="SpeakSelection_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x1F5EF;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Auswahl Sprechen"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource TileRed}" Click="StopSpeak_Click">
                            <StackPanel><TextBlock Style="{StaticResource TileGlyph}" Text="&#x23F9;"/>
                                <TextBlock Style="{StaticResource TileLabel}" Text="Sprechen Beenden"/></StackPanel>
                        </Button>
                </UniformGrid>
            </Grid>
        </TabItem>

        <!-- ===================== SETTINGS TAB ===================== -->
        <TabItem x:Name="SettingsTab" Header="  Einstellungen  " FontSize="18">
            <Grid Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,150,6">
                    <Button Style="{StaticResource BigNavButton}" Click="Write_Click" Content="&#x270F;  Zum Schreiben"/>
                    <Button Style="{StaticResource ToolButton}" MinHeight="72" Click="Speak_Click" Content="&#x1F50A;  Zum Vorlesen"/>
                </WrapPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Sprache" FontSize="18" Margin="4,4,4,2" Opacity="0.8"/>
                        <StackPanel Orientation="Horizontal" Margin="4,0,4,8">
                            <RadioButton x:Name="LangGerman" Content="Deutsch" IsChecked="True"
                                         FontSize="20" Margin="0,0,16,0" Foreground="{StaticResource TextForeground}"
                                         Checked="Lang_Changed"/>
                            <RadioButton x:Name="LangEnglish" Content="English"
                                         FontSize="20" Foreground="{StaticResource TextForeground}"
                                         Checked="Lang_Changed"/>
                        </StackPanel>

                        <TextBlock Text="Deutsche Stimme" FontSize="18" Margin="4,4,4,2" Opacity="0.8"/>
                        <ComboBox x:Name="GermanVoiceBox" Margin="4,0,4,8" FontSize="18"
                                  SelectionChanged="Voice_Changed"/>

                        <TextBlock Text="Englische Stimme" FontSize="18" Margin="4,4,4,2" Opacity="0.8"/>
                        <ComboBox x:Name="EnglishVoiceBox" Margin="4,0,4,8" FontSize="18"
                                  SelectionChanged="Voice_Changed"/>

                        <TextBlock Text="Geschwindigkeit" FontSize="18" Margin="4,4,4,2" Opacity="0.8"/>
                        <Slider x:Name="RateSlider" Minimum="0.5" Maximum="3.0" Value="1.0"
                                TickFrequency="0.1" Margin="4,0,4,8" ValueChanged="Rate_Changed"/>

                        <TextBlock Text="Lautstärke" FontSize="18" Margin="4,4,4,2" Opacity="0.8"/>
                        <Slider x:Name="VolumeSlider" Minimum="0.0" Maximum="1.0" Value="1.0"
                                TickFrequency="0.1" Margin="4,0,4,8" ValueChanged="Volume_Changed"/>

                        <Separator Margin="4,10"/>

                        <TextBlock Text="Kopfsteuerung (Verweil-Klick)" FontSize="18"
                                   Margin="4,4,4,2" Opacity="0.8"/>
                        <CheckBox x:Name="DwellEnabledBox" Content="Aktiviert" FontSize="20"
                                  Margin="4,2,4,6" Foreground="{StaticResource TextForeground}"
                                  Checked="Dwell_Changed" Unchecked="Dwell_Changed"/>
                        <TextBlock x:Name="DwellTimeLabel" Text="Verweilzeit: 1,2 s"
                                   FontSize="18" Margin="4,4,4,2" Opacity="0.8"/>
                        <StackPanel Orientation="Horizontal" Margin="4,0,4,8">
                            <Button Style="{StaticResource ToolButton}" Click="DwellMinus_Click"
                                    Content="&#x2212;" MinWidth="56" FontSize="24"/>
                            <Slider x:Name="DwellSlider" Width="180" VerticalAlignment="Center"
                                    Minimum="0.4" Maximum="3.0" Value="1.2" TickFrequency="0.1"
                                    Margin="6,0" ValueChanged="DwellTime_Changed"/>
                            <Button Style="{StaticResource ToolButton}" Click="DwellPlus_Click"
                                    Content="&#x002B;" MinWidth="56" FontSize="24"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>
    </TabControl>

        <!-- Sicherheitsabfrage für „Alles löschen": liegt über der gesamten Oberfläche.
             Die rote Fläche ist bewusst KEIN Button, damit der Verweil-Klick der
             Kopfsteuerung (1,2 s) sie nicht auslösen kann. Gelöscht wird erst,
             wenn der Zeiger 10 Sekunden ununterbrochen darauf bleibt. -->
        <Grid x:Name="ConfirmNewOverlay" Visibility="Collapsed" Background="#CC101010">
            <Border Background="{StaticResource PanelBackground}" CornerRadius="14"
                    Padding="36" MaxWidth="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="&#x26A0; Wirklich alles löschen?" FontSize="36" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Der geschriebene Text geht dabei verloren."
                               FontSize="24" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,10,0,28"/>

                    <!-- Farbe direkt statt {StaticResource TileRed}: dieser Schlüssel ist im
                         Fenster doppelt belegt (Brush in App.xaml, Button-Style hier) und
                         würde als Style aufgelöst -> Absturz beim Start. -->
                    <Border x:Name="ConfirmNewHold" Background="#FFC0453F" CornerRadius="10"
                            MinHeight="130" Cursor="Hand"
                            MouseEnter="ConfirmNewHold_MouseEnter" MouseLeave="ConfirmNewHold_MouseLeave">
                        <StackPanel VerticalAlignment="Center" Margin="24,16">
                            <TextBlock x:Name="ConfirmNewHoldLabel"
                                       Text="Ja, alles löschen &#x2013; 10 Sekunden hier bleiben"
                                       FontSize="24" FontWeight="SemiBold" Foreground="White"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ConfirmNewProgress" Height="16" Maximum="100"
                                         Margin="8,14,8,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BigNavButton}" MinHeight="96" FontSize="28"
                            Margin="0,24,0,0" Click="ConfirmNewCancel_Click"
                            Content="&#x2715;  Abbrechen &#x2013; Text behalten"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Wiederherstellen-Abfrage beim Start: als Overlay statt MessageBox, damit sie
             auch per Verweil-Klick (Kopfsteuerung) bedienbar ist – native Dialoge kann
             der DwellClicker nicht klicken. „Nein" ist bewusst ein normaler Button:
             die abgelehnte Sicherung wird nicht gelöscht, sondern nur nach
             autosave.verworfen.rtf verschoben. -->
        <Grid x:Name="RestoreOverlay" Visibility="Collapsed" Background="#CC101010">
            <Border Background="{StaticResource PanelBackground}" CornerRadius="14"
                    Padding="36" MaxWidth="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="&#x1F4C4; Nicht gespeicherter Text gefunden" FontSize="36" FontWeight="Bold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="Aus der letzten Sitzung ist ein nicht gespeicherter Text vorhanden. Möchten Sie ihn wiederherstellen?"
                               FontSize="24" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,10,0,28"/>
                    <Button Style="{StaticResource BigNavButton}" MinHeight="96" FontSize="28"
                            Click="RestoreYes_Click"
                            Content="&#x2714;  Ja, Text wiederherstellen"/>
                    <Button Style="{StaticResource ToolButton}" MinHeight="72" FontSize="24"
                            Margin="0,16,0,0" Click="RestoreNo_Click"
                            Content="&#x2715;  Nein, leer starten"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Sicherheitsabfrage für „Beenden": gleiche Halte-Mechanik wie bei „Alles löschen".
             Das Fenster ist rahmenloses Vollbild (keine Titelleiste, Taskleiste verdeckt),
             darum ist dieser Weg der einzige Ausgang per Kopfsteuerung – ein einfacher
             Verweil-Klick darf die App aber nicht versehentlich schließen. -->
        <Grid x:Name="ConfirmExitOverlay" Visibility="Collapsed" Background="#CC101010">
            <Border Background="{StaticResource PanelBackground}" CornerRadius="14"
                    Padding="36" MaxWidth="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="&#x23FB; TouchSpeak wirklich beenden?" FontSize="36" FontWeight="Bold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Der Text bleibt gesichert und wird beim nächsten Start wieder angeboten."
                               FontSize="24" Opacity="0.85" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,10,0,28"/>

                    <Border x:Name="ConfirmExitHold" Background="#FFC0453F" CornerRadius="10"
                            MinHeight="130" Cursor="Hand"
                            MouseEnter="ConfirmExitHold_MouseEnter" MouseLeave="ConfirmExitHold_MouseLeave">
                        <StackPanel VerticalAlignment="Center" Margin="24,16">
                            <TextBlock x:Name="ConfirmExitHoldLabel"
                                       Text="Ja, beenden &#x2013; 5 Sekunden hier bleiben"
                                       FontSize="24" FontWeight="SemiBold" Foreground="White"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                            <ProgressBar x:Name="ConfirmExitProgress" Height="16" Maximum="100"
                                         Margin="8,14,8,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BigNavButton}" MinHeight="96" FontSize="28"
                            Margin="0,24,0,0" Click="ConfirmExitCancel_Click"
                            Content="&#x2715;  Abbrechen &#x2013; weiter schreiben"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Fehlermeldungen als Banner statt MessageBox: per Verweil-Klick schließbar
             und verschwindet nach einigen Sekunden von selbst. -->
        <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#FFB3261E" CornerRadius="10"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,16,16,0"
                Padding="20,12" MaxWidth="900">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ErrorBannerText" Foreground="White" FontSize="22"
                           TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="640"/>
                <Button Style="{StaticResource ToolButton}" Content="OK" MinWidth="90"
                        Margin="16,0,0,0" Click="ErrorBanner_Close"/>
            </StackPanel>
        </Border>

        <!-- Pause (Bediensperre): deckt alle Seiten und Abfragen ab und schluckt jede
             Eingabe – auch der Verweil-Klick findet darunter keine Schaltfläche mehr.
             Einzig die Pause-Taste darüber bleibt bedienbar und hebt die Sperre auf. -->
        <Grid x:Name="LockOverlay" Visibility="Collapsed" Background="{StaticResource LockOverlayBackground}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <TextBlock Text="&#x1F4A4;" FontSize="110" Foreground="White" Opacity="0.9"
                           TextAlignment="Center"/>
                <TextBlock Text="Pause &#x2013; Bedienung gesperrt" FontSize="40" FontWeight="Bold"
                           Foreground="White" TextAlignment="Center" Margin="0,8,0,12"/>
                <TextBlock Text="Alle Tasten sind gesperrt, damit nichts aus Versehen passiert. Zum Weitermachen oben rechts auf die rot leuchtende Pause-Taste klicken."
                           FontSize="24" Foreground="White" Opacity="0.85"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="760"/>
            </StackPanel>
        </Grid>

        <Button x:Name="PauseButton" Style="{StaticResource PauseButton}" Click="Pause_Click"
                Content="&#x1F4A4;  Pause"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"/>

        <!-- Overlay für den Verweil-Klick-Fortschrittsring (Kopfsteuerung).
             Liegt über allem und lässt Maus-/Kopfmaus-Eingaben durch. -->
        <Canvas x:Name="DwellOverlay" IsHitTestVisible="False"/>
    </Grid>
</Window>
